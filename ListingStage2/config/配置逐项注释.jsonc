          // 支撑该卖点的组件ID，必须属于本次输入包。
          "evidence_part_ids": ["b322ef77362704015b585cd99881b405f6bc43d550b342a1ddb0a38ea495da53", "75c80633db30f8e341356561b579a9ef8aa83a59bc1c84a8235901bbefd11161", "7f6482514bdbbbb4ac256484ec629bc25588f97ec1418f17967ebe3ca04eeccf", "64bd6ae4b0e7650ce9387cfe668d5edb66721500c599bd9242fb28d1847504c8", "f72ba47a6df70aab6d076d3b00a6d081f173ae646ee07642fe64705e622081b8"],
