      "scenes": ["卧室产品展示", "手部触感演示", "侧卧睡眠", "床角安装", "家庭床上生活场景"],
      // 构图、配色、光线等整套视觉风格。
      "visual_style": ["深灰产品纹理近景", "绿色自然主题的A+", "浅色卧室与深色产品对比", "文字标注和箭头解释"],
      // 标题、五点等信息组织方式，不是直接复用竞品文案。
      "copy_structure": {
        // 标题组件规则。
        "title": "品类、尺寸、柔软等卖点与来源功效声明",
        // 五点表达顺序或结构分析，不控制原始条数。
        "bullets": "柔软与材料/尺寸 → 舒适与支撑 → 安装与恢复 → 机洗 → 满意度承诺",
        // A+图片或已有A+文本组件规则。
        "aplus": "生活场景 → 柔软 → 清凉/透气 → 支撑 → 包覆固定 → 信任与家庭场景"
      },
      // 可借鉴表达原则，需要结合自有产品事实和场景核对。
      "transferable_principles": ["将触感近景、人物使用场景与文字利益点组织成同一套柔软舒适表达。", "安装类卖点使用动作图或视频展示，比只有形容词更便于理解。", "图片、五点与视频重复同一核心主题，同时分别承担外观、场景、操作说明。"],
      // 缺失、不可验证和不适用事项；不能在生成阶段自动忽略。
      "limitations": ["普通详情在原快照缺失，不补造。", "只取得图库前4张和7张A+，整套指本次实际采集范围，非网站全部内容。", "人物和系列图可能为通用品牌素材，不证明所选变体的所有外观与参数。", "清凉、疼痛缓解、化学物质声明、媒体背书、认证标识和客户规模均未经独立验证。", "视频只分析8个关键帧，没有语音转录。"],
      // 整套综合英文叙述，独立编码成整体向量；不得超过当前6000字符预算。
      "embedding_text_en": "A US Niagara charcoal quilted pillow-top mattress pad Listing organized around ultra-soft, cloud-like comfort. The main image emphasizes a raised quilted surface in a bedroom. Secondary and A+ images combine tactile hand-press softness imagery, side-sleeping lifestyle scenes, green natural backgrounds, airflow-arrow graphics and elastic deep-pocket fitting. The video samples repeat the same narrative: sleeping bedroom, fabric close-up, hands fitting the side skirt, palm and fingertip contact, breathability/cooling text and sleeping person. Copy progresses from softness and material/size claims to cushioning/support, installation and package recovery, washability and satisfaction. Intended expression: added bed comfort, airy/cooling feel, secure fit and easy care; hot sleepers are explicitly addressed. Reusable strategy is coordinated product close-ups, touch demonstrations, sleeping scenes and installation actions across images, video and copy. Softness, support, cooling, pain-relief, material, certification and media claims remain competitor statements, not independently verified product facts. Scope: four gallery images, seven A+ images, source copy and eight sampled video frames; ordinary description absent and audio not transcribed."
    }
  },
